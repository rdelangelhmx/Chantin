{
    "DetailedErrors": true, // turns on CircuitOptions.DetailedErrors
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "EventSource": {
            "IncludeScopes": true,
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "EventLog": {
            "IncludeScopes": true,
            "LogLevel": {
                "Default": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "Console": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    }
}
